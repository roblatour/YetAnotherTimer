<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Exclude DataStore from cloud backup/restore -->
        <exclude domain="files" path="datastore/settings.preferences_pb" />
        <exclude domain="files" path="datastore/" />
    </cloud-backup>
    <device-transfer>
        <!-- Also exclude during device-to-device transfer -->
        <exclude domain="files" path="datastore/settings.preferences_pb" />
        <exclude domain="files" path="datastore/" />
    </device-transfer>
</data-extraction-rules>